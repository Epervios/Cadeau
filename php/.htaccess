# Le répertoire php/ peut être la racine web sur hébergement mutualisé.
# Autoriser uniquement les pages statiques publiques et les 3 points d'entrée API.
Options -Indexes
RewriteEngine On
RewriteRule ^$ public/index.html [R=302,L]
RewriteRule ^(?:config|includes|bin|migrations|tests)(?:/|$) - [F,L,NC]
RewriteRule ^api/(?!auth\.php$|admin\.php$|user\.php$).+ - [F,L,NC]
RewriteRule ^(?!api/|public/).+ - [F,L,NC]
<FilesMatch "(?i)\.(?:sql|md|env|log|bak|ini|dist)$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
    # N'activer HSTS que lorsque HTTPS est activé sur l'ensemble du domaine.
</IfModule>
